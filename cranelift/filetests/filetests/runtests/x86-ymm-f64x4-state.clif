test run
set preserve_frame_pointers=true
target x86_64 has_avx has_avx2 has_sse41
set regalloc_algorithm=single_pass
target x86_64 has_avx has_avx2 has_sse41

; Stores of single lanes, register pressure, block-parameter cycles and
; 256-bit values live across calls.

; `store (extractlane v, n)` must not fuse into a 128-bit lane store.
function %store_i64_lanes(i64, i64, i64, i64) -> i64x2, i64x2 {
    ss0 = explicit_slot 32
block0(v0: i64, v1: i64, v2: i64, v3: i64):
    v4 = splat.i64x4 v0
    v5 = insertlane v4, v1, 1
    v6 = insertlane v5, v2, 2
    v7 = insertlane v6, v3, 3
    v8 = stack_addr.i64 ss0
    v9 = extractlane v7, 0
    store v9, v8
    v10 = extractlane v7, 1
    store v10, v8+8
    v11 = extractlane v7, 2
    store v11, v8+16
    v12 = extractlane v7, 3
    store v12, v8+24
    v13 = load.i64 v8
    v14 = load.i64 v8+8
    v15 = load.i64 v8+16
    v16 = load.i64 v8+24
    v17 = scalar_to_vector.i64x2 v13
    v18 = insertlane v17, v14, 1
    v19 = scalar_to_vector.i64x2 v15
    v20 = insertlane v19, v16, 1
    return v18, v20
}
; run: %store_i64_lanes(10, 11, 12, 13) == [[10 11], [12 13]]

function %store_f64_lanes(f64, f64, f64, f64) -> f64x2, f64x2 {
    ss0 = explicit_slot 32
block0(v0: f64, v1: f64, v2: f64, v3: f64):
    v4 = splat.f64x4 v0
    v5 = insertlane v4, v1, 1
    v6 = insertlane v5, v2, 2
    v7 = insertlane v6, v3, 3
    v8 = stack_addr.i64 ss0
    v9 = extractlane v7, 3
    store v9, v8
    v10 = extractlane v7, 2
    store v10, v8+8
    v11 = extractlane v7, 1
    store v11, v8+16
    v12 = extractlane v7, 0
    store v12, v8+24
    v13 = load.f64 v8
    v14 = load.f64 v8+8
    v15 = load.f64 v8+16
    v16 = load.f64 v8+24
    v17 = scalar_to_vector.f64x2 v13
    v18 = insertlane v17, v14, 1
    v19 = scalar_to_vector.f64x2 v15
    v20 = insertlane v19, v16, 1
    return v18, v20
}
; run: %store_f64_lanes(0x1.0, 0x2.0, 0x3.0, 0x4.0) == [[0x4.0 0x3.0], [0x2.0 0x1.0]]

; A lane of a loaded vector, stored without passing through a register of
; its own.
function %store_loaded_lane(i64, i64, i64, i64) -> i64, i64 {
    ss0 = explicit_slot 32
    ss1 = explicit_slot 16
block0(v0: i64, v1: i64, v2: i64, v3: i64):
    v4 = stack_addr.i64 ss0
    store v0, v4
    store v1, v4+8
    store v2, v4+16
    store v3, v4+24
    v5 = load.i64x4 v4
    v6 = stack_addr.i64 ss1
    v7 = extractlane v5, 3
    store v7, v6
    v8 = extractlane v5, 2
    store v8, v6+8
    v9 = load.i64 v6
    v10 = load.i64 v6+8
    return v9, v10
}
; run: %store_loaded_lane(10, 11, 12, 13) == [13, 12]

; More than 16 live 256-bit values (from the review of PR #1227).
function %pressure(f64, f64) -> f64x2, f64x2 {
block0(v0: f64, v1: f64):
    v2 = splat.f64x4 v0
    v3 = splat.f64x4 v1
    v4 = insertlane v2, v1, 0
    v5 = fadd v4, v3
    v6 = insertlane v5, v1, 1
    v7 = fadd v6, v3
    v8 = insertlane v7, v1, 2
    v9 = fadd v8, v3
    v10 = insertlane v9, v1, 3
    v11 = fadd v10, v3
    v12 = insertlane v11, v1, 0
    v13 = fadd v12, v3
    v14 = insertlane v13, v1, 1
    v15 = fadd v14, v3
    v16 = insertlane v15, v1, 2
    v17 = fadd v16, v3
    v18 = insertlane v17, v1, 3
    v19 = fadd v18, v3
    v20 = insertlane v19, v1, 0
    v21 = fadd v20, v3
    v22 = insertlane v21, v1, 1
    v23 = fadd v22, v3
    v24 = insertlane v23, v1, 2
    v25 = fadd v24, v3
    v26 = insertlane v25, v1, 3
    v27 = fadd v26, v3
    v28 = insertlane v27, v1, 0
    v29 = fadd v28, v3
    v30 = insertlane v29, v1, 1
    v31 = fadd v30, v3
    v32 = insertlane v31, v1, 2
    v33 = fadd v32, v3
    v34 = insertlane v33, v1, 3
    v35 = fadd v34, v3
    v36 = insertlane v35, v1, 0
    v37 = fadd v36, v3
    v38 = insertlane v37, v1, 1
    v39 = fadd v38, v3
    v40 = insertlane v39, v1, 2
    v41 = fadd v40, v3
    v42 = insertlane v41, v1, 3
    v43 = fadd v42, v3
    v44 = fmul v43, v41
    v45 = fsub v44, v41
    v46 = fmul v45, v39
    v47 = fsub v46, v39
    v48 = fmul v47, v37
    v49 = fsub v48, v37
    v50 = fmul v49, v35
    v51 = fsub v50, v35
    v52 = fmul v51, v33
    v53 = fsub v52, v33
    v54 = fmul v53, v31
    v55 = fsub v54, v31
    v56 = fmul v55, v29
    v57 = fsub v56, v29
    v58 = fmul v57, v27
    v59 = fsub v58, v27
    v60 = fmul v59, v25
    v61 = fsub v60, v25
    v62 = fmul v61, v23
    v63 = fsub v62, v23
    v64 = fmul v63, v21
    v65 = fsub v64, v21
    v66 = fmul v65, v19
    v67 = fsub v66, v19
    v68 = fmul v67, v17
    v69 = fsub v68, v17
    v70 = fmul v69, v15
    v71 = fsub v70, v15
    v72 = fmul v71, v13
    v73 = fsub v72, v13
    v74 = fmul v73, v11
    v75 = fsub v74, v11
    v76 = fmul v75, v9
    v77 = fsub v76, v9
    v78 = fmul v77, v7
    v79 = fsub v78, v7
    v80 = fmul v79, v5
    v81 = fsub v80, v5
    v82 = x86_vextractf128.f64x2 v81, 0
    v83 = x86_vextractf128.f64x2 v81, 1
    return v82, v83
}
; run: %pressure(0x1.0p-1, 0x1.0p-2) == [[-0x1.8ef3be4p1 -0x1.89e919p1], [-0x1.e82c26cp1 -0x1.534c1bep2]]
; run: %pressure(-0x1.0, 0x1.0p-3) == [[-0x1.bafa51fb4f2p-2 0x1.40e6c13c8828], [-0x1.0ad0fc96724p-4 0x1.9cd84f9d52d8p-1]]
; run: %pressure(0x0.0, -0x0.0) == [[0x0.0 0x0.0], [0x0.0 0x0.0]]

function %swap_loop(f64, f64, i64) -> f64x2, f64x2 {
block0(v0: f64, v1: f64, v2: i64):
    v3 = splat.f64x4 v0
    v4 = splat.f64x4 v1
    v5 = insertlane v4, v0, 3
    jump block1(v3, v5, v2)
block1(v6: f64x4, v7: f64x4, v8: i64):
    v9 = iconst.i64 0
    v10 = icmp eq v8, v9
    brif v10, block3, block2
block2:
    v11 = iconst.i64 1
    v12 = isub v8, v11
    v13 = fadd v6, v7
    jump block1(v7, v13, v12)
block3:
    v14 = x86_vextractf128.f64x2 v6, 0
    v15 = x86_vextractf128.f64x2 v7, 1
    return v14, v15
}
; run: %swap_loop(0x1.0, 0x1.0p1, 5) == [[0x1.ap3 0x1.ap3], [0x1.5p4 0x1.ap3]]
; run: %swap_loop(0x1.0p-1, -0x1.8p1, 7) == [[-0x1.18p5 -0x1.18p5], [-0x1.c4p5 0x1.1p4]]

; Block parameters exchanged on every iteration: a two-cycle and a
; three-cycle of 256-bit values.
function %swap2(f64, f64, i64) -> f64, f64 {
block0(v0: f64, v1: f64, v2: i64):
    v3 = splat.f64x4 v0
    v4 = splat.f64x4 v1
    v5 = insertlane v3, v1, 3
    v6 = insertlane v4, v0, 3
    jump block1(v5, v6, v2)
block1(v7: f64x4, v8: f64x4, v9: i64):
    brif v9, block2, block3
block2:
    v10 = iconst.i64 1
    v11 = isub v9, v10
    jump block1(v8, v7, v11)
block3:
    v12 = extractlane v7, 0
    v13 = extractlane v7, 3
    return v12, v13
}
; run: %swap2(0x1.0, 0x2.0, 0) == [0x1.0, 0x2.0]
; run: %swap2(0x1.0, 0x2.0, 1) == [0x2.0, 0x1.0]
; run: %swap2(0x1.0, 0x2.0, 6) == [0x1.0, 0x2.0]
; run: %swap2(0x1.0, 0x2.0, 7) == [0x2.0, 0x1.0]

function %swap3(f64, f64, f64, i64) -> f64x2, f64 {
block0(v0: f64, v1: f64, v2: f64, v3: i64):
    v4 = splat.f64x4 v0
    v5 = splat.f64x4 v1
    v6 = splat.f64x4 v2
    v7 = insertlane v4, v2, 2
    jump block1(v7, v5, v6, v3)
block1(v8: f64x4, v9: f64x4, v10: f64x4, v11: i64):
    brif v11, block2, block3
block2:
    v12 = iconst.i64 1
    v13 = isub v11, v12
    jump block1(v9, v10, v8, v13)
block3:
    v14 = extractlane v8, 2
    v15 = extractlane v9, 3
    v16 = extractlane v10, 1
    v17 = scalar_to_vector.f64x2 v14
    v18 = insertlane v17, v15, 1
    return v18, v16
}
; run: %swap3(0x1.0, 0x2.0, 0x3.0, 0) == [[0x3.0 0x2.0], 0x3.0]
; run: %swap3(0x1.0, 0x2.0, 0x3.0, 1) == [[0x2.0 0x3.0], 0x1.0]
; run: %swap3(0x1.0, 0x2.0, 0x3.0, 2) == [[0x3.0 0x1.0], 0x2.0]
; run: %swap3(0x1.0, 0x2.0, 0x3.0, 3) == [[0x3.0 0x2.0], 0x3.0]

; Writes vector registers with 128-bit (legacy SSE and VEX.128) and 256-bit
; values. clobber(x) = 2x + 2x^2.
function %clobber(f64) -> f64 {
    ss0 = explicit_slot 32
block0(v0: f64):
    v1 = splat.f64x2 v0
    v2 = fadd v1, v1
    v3 = fmul v2, v1
    v4 = splat.f64x4 v0
    v5 = fadd v4, v4
    v6 = stack_addr.i64 ss0
    store v5, v6
    v7 = load.f64 v6+24
    v8 = extractlane v3, 1
    v9 = fadd v7, v8
    return v9
}

; An accumulator live across a call on every iteration.
function %call_in_loop(f64, f64, f64, f64, i64) -> f64x2, f64x2 {
    fn0 = %clobber(f64) -> f64
block0(v0: f64, v1: f64, v2: f64, v3: f64, v4: i64):
    v5 = splat.f64x4 v0
    v6 = insertlane v5, v1, 1
    v7 = insertlane v6, v2, 2
    v8 = insertlane v7, v3, 3
    v9 = f64const 0x1.0
    jump block1(v8, v9, v4)
block1(v10: f64x4, v11: f64, v12: i64):
    brif v12, block2, block3
block2:
    v13 = call fn0(v11)
    v14 = splat.f64x4 v13
    v15 = fadd v10, v14
    v16 = iconst.i64 1
    v17 = isub v12, v16
    jump block1(v15, v11, v17)
block3:
    v18 = x86_vextractf128.f64x2 v10, 0
    v19 = x86_vextractf128.f64x2 v10, 1
    return v18, v19
}
; clobber(1) = 2 + 2 = 4, added once per iteration.
; run: %call_in_loop(0x1.0, 0x2.0, 0x3.0, 0x4.0, 0) == [[0x1.0 0x2.0], [0x3.0 0x4.0]]
; run: %call_in_loop(0x1.0, 0x2.0, 0x3.0, 0x4.0, 3) == [[0xd.0 0xe.0], [0xf.0 0x10.0]]

function %clobber_tail(f64) -> f64 tail {
    fn0 = %clobber(f64) -> f64
block0(v0: f64):
    v1 = call fn0(v0)
    return v1
}

; A 256-bit value live across `try_call` on its normal-return edge.
function %across_try_call(f64, f64, f64, f64) -> f64x2, f64x2 {
    sig0 = (f64) -> f64 tail
    fn0 = %clobber_tail(f64) -> f64 tail
block0(v0: f64, v1: f64, v2: f64, v3: f64):
    v4 = splat.f64x4 v0
    v5 = insertlane v4, v1, 1
    v6 = insertlane v5, v2, 2
    v7 = insertlane v6, v3, 3
    v8 = fadd v7, v7
    try_call fn0(v0), sig0, block1(ret0), []
block1(v9: f64):
    v10 = splat.f64x4 v9
    v11 = fadd v8, v10
    v12 = x86_vextractf128.f64x2 v11, 0
    v13 = x86_vextractf128.f64x2 v11, 1
    return v12, v13
}
; run: %across_try_call(0x1.0, 0x2.0, 0x3.0, 0x4.0) == [[0x6.0 0x8.0], [0xa.0 0xc.0]]

; A 256-bit value computed before a tail call; the callee runs with clean
; upper halves and returns directly to the caller's caller.
function %tail_callee(f64, f64) -> f64 tail {
block0(v0: f64, v1: f64):
    v2 = splat.f64x2 v0
    v3 = splat.f64x2 v1
    v4 = fmul v2, v3
    v5 = splat.f64x4 v0
    v6 = fadd v5, v5
    v7 = extractlane v6, 3
    v8 = extractlane v4, 1
    v9 = fadd v7, v8
    return v9
}

function %into_tail_call(f64, f64, f64, f64) -> f64 tail {
    fn0 = %tail_callee(f64, f64) -> f64 tail
block0(v0: f64, v1: f64, v2: f64, v3: f64):
    v4 = splat.f64x4 v0
    v5 = insertlane v4, v1, 1
    v6 = insertlane v5, v2, 2
    v7 = insertlane v6, v3, 3
    v8 = fmul v7, v7
    v9 = extractlane v8, 3
    v10 = extractlane v8, 1
    return_call fn0(v9, v10)
}
; tail_callee(16, 4) = 32 + 64.
; run: %into_tail_call(0x1.0, 0x2.0, 0x3.0, 0x4.0) == 0x60.0
