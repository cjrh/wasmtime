test run
target x86_64 has_avx has_avx2 has_sse41
set regalloc_algorithm=single_pass
target x86_64 has_avx has_avx2 has_sse41

; Every condition `ymm.rs` admits, on lanes holding NaN, signed zeros and
; infinities. Lane i of the mask sets bit i of the result.

function %fcmp_eq(f64, f64, f64, f64, f64, f64, f64, f64) -> i64 {
block0(v0: f64, v1: f64, v2: f64, v3: f64, v4: f64, v5: f64, v6: f64, v7: f64):
    v8 = splat.f64x4 v0
    v9 = insertlane v8, v1, 1
    v10 = insertlane v9, v2, 2
    v11 = insertlane v10, v3, 3
    v12 = splat.f64x4 v4
    v13 = insertlane v12, v5, 1
    v14 = insertlane v13, v6, 2
    v15 = insertlane v14, v7, 3
    v16 = fcmp eq v11, v15
    v17 = extractlane v16, 0
    v18 = extractlane v16, 1
    v19 = extractlane v16, 2
    v20 = extractlane v16, 3
    v21 = iconst.i64 1
    v22 = band v17, v21
    v23 = band v18, v21
    v24 = band v19, v21
    v25 = band v20, v21
    v26 = iconst.i64 2
    v27 = iconst.i64 3
    v28 = ishl v23, v21
    v29 = ishl v24, v26
    v30 = ishl v25, v27
    v31 = bor v22, v28
    v32 = bor v29, v30
    v33 = bor v31, v32
    return v33
}
; run: %fcmp_eq(+NaN, 0x0.0, -0x0.0, +Inf, 0x1.0, -0x0.0, 0x0.0, +Inf) == 14
; run: %fcmp_eq(-Inf, +Inf, +NaN, 0x0.0, +Inf, -Inf, +NaN, -0x0.0) == 8
; run: %fcmp_eq(0x1.0, -Inf, 0x2.0, -0x0.0, +NaN, -Inf, 0x1.0, -Inf) == 2
; run: %fcmp_eq(+Inf, -0x0.0, -0x1.0, +NaN, +NaN, -0x0.0, -0x0.0, -Inf) == 2

