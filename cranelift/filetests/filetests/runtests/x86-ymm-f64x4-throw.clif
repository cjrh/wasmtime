test run
set preserve_frame_pointers=true
target x86_64 has_avx has_avx2 has_sse41
set regalloc_algorithm=single_pass
target x86_64 has_avx has_avx2 has_sse41

; A 256-bit value live across `try_call` into both the normal-return and
; the exception edge. The pattern follows `throw.clif`.

function %entry(i64) -> f64 tail {
    fn0 = %main(i64, i64) -> f64 tail
block0(v0: i64):
    v1 = get_frame_pointer.i64
    v2 = call fn0(v1, v0)
    return v2
}
; run: %entry(0) == 0x1.4p3
; run: %entry(1) == 0x1.e8p5

function %main(i64, i64) -> f64 tail {
    sig0 = (i64, i32, i64, i64) tail
    fn0 = %maybe_throw(i64, i32, i64, i64) tail
block0(v0: i64, v1: i64):
    v2 = f64const 0x1.0
    v3 = f64const 0x2.0
    v4 = f64const 0x3.0
    v5 = f64const 0x4.0
    v6 = splat.f64x4 v2
    v7 = insertlane v6, v3, 1
    v8 = insertlane v7, v4, 2
    v9 = insertlane v8, v5, 3
    v10 = fmul v9, v9
    v11 = iconst.i32 1
    v12 = iconst.i64 42
    try_call fn0(v0, v11, v1, v12), sig0, block1(), [ tag1: block2(exn0, exn1) ]

; Normal return: 1 + 9 = 10.
block1:
    v13 = extractlane v10, 0
    v14 = extractlane v10, 2
    v15 = fadd v13, v14
    return v15

; Exception, with payloads 1 and 42: 16 + 4 + (42 - 1) = 61.
block2(v16: i64, v17: i64):
    v18 = extractlane v10, 3
    v19 = extractlane v10, 1
    v20 = fadd v18, v19
    v21 = isub v17, v16
    v22 = fcvt_from_sint.f64 v21
    v23 = fadd v20, v22
    return v23
}

; Throws `flag` and `payload` when `flag` is nonzero; otherwise writes a
; vector register and returns.
function %maybe_throw(i64, i32, i64, i64) tail {
    sig0 = (i64, i64, i64, i32, i64, i64)
    fn0 = %__cranelift_throw(i64, i64, i64, i32, i64, i64)
block0(v0: i64, v1: i32, v2: i64, v3: i64):
    brif v2, block2, block1
block1:
    v5 = f64const 0x7.0
    v6 = splat.f64x4 v5
    v7 = fadd v6, v6
    v8 = extractlane v7, 3
    v9 = fcvt_from_sint.f64 v3
    v10 = fadd v8, v9
    return
block2:
    v11 = get_frame_pointer.i64
    v12 = get_return_address.i64
    v13 = load.i64 v12
    v14 = func_addr.i64 fn0
    call_indirect sig0, v14(v0, v11, v13, v1, v2, v3)
    return
}
