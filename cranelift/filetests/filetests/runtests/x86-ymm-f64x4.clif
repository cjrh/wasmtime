test run
target x86_64 has_avx has_avx2 has_sse41
set regalloc_algorithm=single_pass
target x86_64 has_avx has_avx2 has_sse41

; 256-bit vectors cannot be passed or returned, so each test builds them from
; scalars and returns one lane.

function %build(f64, f64, f64, f64) -> f64x2, f64x2 {
block0(v0: f64, v1: f64, v2: f64, v3: f64):
    v4 = splat.f64x4 v0
    v5 = insertlane v4, v1, 1
    v6 = insertlane v5, v2, 2
    v7 = insertlane v6, v3, 3
    v8 = extractlane v7, 0
    v9 = extractlane v7, 1
    v10 = extractlane v7, 2
    v11 = extractlane v7, 3
    v90 = scalar_to_vector.f64x2 v8
    v91 = insertlane v90, v9, 1
    v92 = scalar_to_vector.f64x2 v10
    v93 = insertlane v92, v11, 1
    return v91, v93
}
; run: %build(0x1.0, 0x2.0, 0x3.0, 0x4.0) == [[0x1.0 0x2.0], [0x3.0 0x4.0]]
; run: %build(-0x0.0, +Inf, -Inf, +NaN:0x1234) == [[-0x0.0 +Inf], [-Inf +NaN:0x1234]]

function %arith(f64, f64, f64, f64) -> f64x2, f64x2 {
block0(v0: f64, v1: f64, v2: f64, v3: f64):
    v4 = splat.f64x4 v0
    v5 = insertlane v4, v1, 1
    v6 = insertlane v5, v2, 2
    v7 = insertlane v6, v3, 3
    v8 = fadd v7, v7
    v9 = fmul v8, v7
    v10 = fsub v9, v7
    v11 = fdiv v10, v8
    v12 = sqrt v11
    v13 = extractlane v12, 0
    v14 = extractlane v12, 1
    v15 = extractlane v12, 2
    v16 = extractlane v12, 3
    v90 = scalar_to_vector.f64x2 v13
    v91 = insertlane v90, v14, 1
    v92 = scalar_to_vector.f64x2 v15
    v93 = insertlane v92, v16, 1
    return v91, v93
}
; (2x*x - x) / 2x = x - 0.5, then sqrt.
; The x86 default NaN has the sign bit set.
; run: %arith(0x4.8, 0x1.0, -0x1.0, +Inf) == [[0x2.0 0x1.6a09e667f3bcdp-1], [-NaN -NaN]]

function %memory(f64, f64, f64, f64) -> f64, f64x2 {
    ss0 = explicit_slot 32
    ss1 = explicit_slot 32
block0(v0: f64, v1: f64, v2: f64, v3: f64):
    v4 = splat.f64x4 v0
    v5 = insertlane v4, v1, 1
    v6 = insertlane v5, v2, 2
    v7 = insertlane v6, v3, 3
    v8 = stack_addr.i64 ss0
    store v7, v8
    v9 = load.f64x4 v8
    v10 = fadd v9, v9
    v11 = stack_addr.i64 ss1
    store v10, v11
    v12 = load.f64 v11+24
    v13 = load.f64x2 v11
    return v12, v13
}
; run: %memory(0x1.0, 0x2.0, 0x3.0, 0x4.0) == [0x8.0, [0x2.0 0x4.0]]

function %halves(f64, f64, f64, f64) -> f64x2, f64x2 {
block0(v0: f64, v1: f64, v2: f64, v3: f64):
    v4 = splat.f64x4 v0
    v5 = insertlane v4, v1, 1
    v6 = insertlane v5, v2, 2
    v7 = insertlane v6, v3, 3
    v8 = x86_vextractf128.f64x2 v7, 0
    v9 = x86_vextractf128.f64x2 v7, 1
    return v8, v9
}
; run: %halves(0x1.0, 0x2.0, 0x3.0, 0x4.0) == [[0x1.0 0x2.0], [0x3.0 0x4.0]]

function %swap_halves(f64, f64, f64, f64) -> f64, f64 {
block0(v0: f64, v1: f64, v2: f64, v3: f64):
    v4 = splat.f64x4 v0
    v5 = insertlane v4, v1, 1
    v6 = insertlane v5, v2, 2
    v7 = insertlane v6, v3, 3
    v8 = x86_vextractf128.f64x2 v7, 0
    v9 = x86_vextractf128.f64x2 v7, 1
    v10 = x86_vinsertf128.f64x4 v9, v8
    v11 = extractlane v10, 0
    v12 = extractlane v10, 3
    return v11, v12
}
; run: %swap_halves(0x1.0, 0x2.0, 0x3.0, 0x4.0) == [0x3.0, 0x2.0]

function %concat(f64x2, f64x2) -> f64x2, f64x2 {
block0(v0: f64x2, v1: f64x2):
    v2 = x86_vinsertf128.f64x4 v0, v1
    v3 = extractlane v2, 0
    v4 = extractlane v2, 1
    v5 = extractlane v2, 2
    v6 = extractlane v2, 3
    v90 = scalar_to_vector.f64x2 v3
    v91 = insertlane v90, v4, 1
    v92 = scalar_to_vector.f64x2 v5
    v93 = insertlane v92, v6, 1
    return v91, v93
}
; run: %concat([0x1.0 0x2.0], [0x3.0 0x4.0]) == [[0x1.0 0x2.0], [0x3.0 0x4.0]]

function %select_lt(f64, f64, f64, f64) -> f64x2, f64x2 {
block0(v0: f64, v1: f64, v2: f64, v3: f64):
    v4 = splat.f64x4 v0
    v5 = insertlane v4, v1, 1
    v6 = insertlane v5, v2, 2
    v7 = insertlane v6, v3, 3
    v8 = f64const 0x2.0
    v9 = splat.f64x4 v8
    v10 = fcmp lt v7, v9
    v11 = bitcast.f64x4 v10
    v12 = bitselect v11, v7, v9
    v13 = extractlane v12, 0
    v14 = extractlane v12, 1
    v15 = extractlane v12, 2
    v16 = extractlane v12, 3
    v90 = scalar_to_vector.f64x2 v13
    v91 = insertlane v90, v14, 1
    v92 = scalar_to_vector.f64x2 v15
    v93 = insertlane v92, v16, 1
    return v91, v93
}
; min(x, 2) with NaN taking 2.
; run: %select_lt(0x1.0, 0x3.0, +NaN, -Inf) == [[0x1.0 0x2.0], [0x2.0 -Inf]]

; Lane i of the mask sets bit i of the result. With a = [1, NaN, 2, 3] and
; b = [2, 2, 2, NaN], the lanes are less, unordered, equal and unordered.

function %fcmp_eq() -> i64 {
block0:
    v0 = f64const 0x1.0
    v1 = f64const +NaN
    v2 = f64const 0x2.0
    v3 = f64const 0x3.0
    v4 = splat.f64x4 v0
    v5 = insertlane v4, v1, 1
    v6 = insertlane v5, v2, 2
    v7 = insertlane v6, v3, 3
    v8 = splat.f64x4 v2
    v9 = insertlane v8, v1, 3
    v10 = fcmp eq v7, v9
    v11 = extractlane v10, 0
    v12 = extractlane v10, 1
    v13 = extractlane v10, 2
    v14 = extractlane v10, 3
    v15 = iconst.i64 1
    v16 = band v11, v15
    v17 = band v12, v15
    v18 = band v13, v15
    v19 = band v14, v15
    v26 = iconst.i64 1
    v27 = iconst.i64 2
    v28 = iconst.i64 3
    v20 = ishl v17, v26
    v21 = ishl v18, v27
    v22 = ishl v19, v28
    v23 = bor v16, v20
    v24 = bor v21, v22
    v25 = bor v23, v24
    return v25
}
; run: %fcmp_eq() == 4

