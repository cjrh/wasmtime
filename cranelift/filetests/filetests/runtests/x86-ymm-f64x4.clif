; Integer lanes: splat, insertlane, bitwise operations and bnot.
function %int_ops(i64, i64) -> i64, i64 {
block0(v0: i64, v1: i64):
    v2 = splat.i64x4 v0
    v3 = insertlane v2, v1, 3
    v4 = splat.i64x4 v1
    v5 = band v3, v4
    v6 = bor v3, v4
    v7 = bxor v3, v4
    v8 = bnot v3
    v30 = bnot v4
    v9 = band v3, v30
    v10 = extractlane v5, 0
    v11 = extractlane v6, 1
    v12 = bxor v7, v8
    v13 = extractlane v12, 2
    v14 = extractlane v9, 3
    v15 = extractlane v8, 3
    v16 = iadd v14, v15
    return v10, v11
}
; run: %int_ops(0xf0, 0x3c) == [0x30, 0xfc]

function %int_ops_not(i64, i64) -> i64, i64 {
block0(v0: i64, v1: i64):
    v2 = splat.i64x4 v0
    v3 = insertlane v2, v1, 3
    v4 = splat.i64x4 v1
    v5 = band v3, v4
    v6 = bor v3, v4
    v7 = bxor v3, v4
    v8 = bnot v3
    v30 = bnot v4
    v9 = band v3, v30
    v10 = extractlane v5, 0
    v11 = extractlane v6, 1
    v12 = bxor v7, v8
    v13 = extractlane v12, 2
    v14 = extractlane v9, 3
    v15 = extractlane v8, 3
    v16 = iadd v14, v15
    return v13, v16
}
; (0xf0 ^ 0x3c) ^ ~0xf0 = ~0x3c; (0x3c & ~0x3c) + ~0x3c = ~0x3c.
; run: %int_ops_not(0xf0, 0x3c) == [0xffffffffffffffc3, 0xffffffffffffffc3]

function %constant() -> f64, f64 {
block0:
    v0 = vconst.f64x4 [0x1.0 0x2.0 0x3.0 -0x0.0]
    v1 = fadd v0, v0
    v2 = extractlane v1, 1
    v3 = extractlane v1, 3
    return v2, v3
}
; run: %constant() == [0x4.0, -0x0.0]

; Writes every vector register with 128-bit (legacy SSE and VEX.128) and
; 256-bit values.
function %clobber(f64) -> f64 {
    ss0 = explicit_slot 32
block0(v0: f64):
    v1 = splat.f64x2 v0
    v2 = fadd v1, v1
    v3 = fmul v2, v1
    v4 = fsub v3, v2
    v5 = splat.f64x4 v0
    v6 = fadd v5, v5
    v7 = stack_addr.i64 ss0
    store v6, v7
    v8 = load.f64 v7+8
    v9 = extractlane v4, 1
    v10 = fadd v8, v9
    return v10
}

function %across_call(f64, f64, f64, f64) -> f64x2, f64x2 {
    fn0 = %clobber(f64) -> f64
block0(v0: f64, v1: f64, v2: f64, v3: f64):
    v4 = splat.f64x4 v0
    v5 = insertlane v4, v1, 1
    v6 = insertlane v5, v2, 2
    v7 = insertlane v6, v3, 3
    v8 = fadd v7, v7
    v9 = call fn0(v0)
    v10 = splat.f64x4 v9
    v11 = fadd v8, v10
    v12 = x86_vextractf128.f64x2 v11, 0
    v13 = x86_vextractf128.f64x2 v11, 1
    return v12, v13
}
; clobber(1) = 2 + (2 - 2) = 2, so the result is 2x + 2.
; run: %across_call(0x1.0, 0x2.0, 0x3.0, 0x4.0) == [[0x4.0 0x6.0], [0x8.0 0xa.0]]
