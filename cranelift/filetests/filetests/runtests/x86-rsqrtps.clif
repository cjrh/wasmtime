test run
target x86_64
target x86_64 has_avx

; The estimate's bits depend on the processor; these lanes are exact on all.
function %special(f32x4) -> f32x4 {
block0(v0: f32x4):
    v1 = x86_rsqrtps v0
    return v1
}
; run: %special([0x0.0 -0x0.0 +Inf +Inf]) == [+Inf -Inf 0x0.0 0x0.0]

; 1 / sqrt(x) within the documented relative error of 1.5 * 2^-12.
function %within_bound(f32x4, f32x4) -> i32x4 {
block0(v0: f32x4, v1: f32x4):
    v2 = x86_rsqrtps v0
    v3 = fmul v2, v1
    v4 = f32const 0x1.ffd000p-1
    v5 = splat.f32x4 v4
    v6 = f32const 0x1.001800p0
    v7 = splat.f32x4 v6
    v8 = fcmp gt v3, v5
    v9 = fcmp lt v3, v7
    v10 = band v8, v9
    return v10
}
; run: %within_bound([0x1.0p0 0x1.0p2 0x1.0p-20 0x1.0p40], [0x1.0p0 0x1.0p1 0x1.0p-10 0x1.0p20]) == [-1 -1 -1 -1]
; run: %within_bound([0x1.2p3 0x1.9p4 0x1.0p-126 0x1.0p126], [0x1.8p1 0x1.4p2 0x1.0p-63 0x1.0p63]) == [-1 -1 -1 -1]
