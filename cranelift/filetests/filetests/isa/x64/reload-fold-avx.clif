;; A function with a 256-bit value spills every vector register 32 bytes
;; wide, so a 256-bit operand reads the whole slot.
function %ymm(i64) {
    sig0 = ()
    fn0 = %g sig0
block0(v0: i64):
    v1 = load.f64x4 v0
    v2 = fadd v1, v1
    call fn0()
    v3 = fadd v2, v1
    store v3, v0
    return
}

