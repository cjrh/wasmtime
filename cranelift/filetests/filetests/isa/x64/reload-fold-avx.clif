;   movq %rbp, %rsp
;   popq %rbp
;   retq

;; A VEX memory operand needs no alignment, so the fold does not depend on
;; where the 8-byte stack slot puts the spill slot.
function %vector_unaligned(f64x2, f64x2) -> f64x2 {
    ss0 = explicit_slot 8
    fn0 = %g(f64x2) -> f64x2
block0(v0: f64x2, v1: f64x2):
    v2 = call fn0(v0)
    v3 = fadd v2, v1
    return v3
}

