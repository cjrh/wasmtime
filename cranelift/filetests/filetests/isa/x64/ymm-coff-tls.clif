test compile precise-output
set tls_model=coff
target x86_64 has_avx has_avx2 has_sse41

;; The COFF TLS sequence is inline loads, not a call: a 256-bit value stays
;; in its register across it, with no `vzeroupper` before it.
function %tls(i64) -> i64 system_v {
    gv0 = symbol colocated tls %sym
block0(v0: i64):
    v1 = load.f64x4 v0
    v2 = tls_value.i64 gv0
    v3 = fadd v1, v1
    store v3, v0
    return v2
}

