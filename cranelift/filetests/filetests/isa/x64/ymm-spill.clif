;; Block parameters: moves between 256-bit values in a loop.
function %loop_swap(i64, i64) {
block0(v0: i64, v1: i64):
    v2 = load.f64x4 v0
    v3 = load.f64x4 v0+32
    jump block1(v1, v2, v3)

block1(v4: i64, v5: f64x4, v6: f64x4):
    v7 = fadd v5, v6
    v9 = iconst.i64 1
    v8 = isub v4, v9
    brif v8, block1(v8, v6, v7), block2

block2:
    store v5, v0
    return
}

