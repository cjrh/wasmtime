test compile precise-output
target x86_64 has_avx has_avx2 has_sse41

;; System V preserves no vector register, so a 256-bit value live across a
;; call is spilled to a 32-byte slot and reloaded whole.
function %across_call(i64) {
    sig0 = ()
    fn0 = %g sig0
block0(v0: i64):
    v1 = load.f64x4 v0
    v2 = fadd v1, v1
    call fn0()
    v3 = fadd v2, v1
    store v3, v0
    return
}

