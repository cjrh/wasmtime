;; Seventeen live values exceed the sixteen vector registers.
function %pressure(i64) {
block0(v0: i64):
    v1 = load.f64x4 v0
    v2 = load.f64x4 v0+32
    v3 = load.f64x4 v0+64
    v4 = load.f64x4 v0+96
    v5 = load.f64x4 v0+128
    v6 = load.f64x4 v0+160
    v7 = load.f64x4 v0+192
    v8 = load.f64x4 v0+224
    v9 = load.f64x4 v0+256
    v10 = load.f64x4 v0+288
    v11 = load.f64x4 v0+320
    v12 = load.f64x4 v0+352
    v13 = load.f64x4 v0+384
    v14 = load.f64x4 v0+416
    v15 = load.f64x4 v0+448
    v16 = load.f64x4 v0+480
    v17 = load.f64x4 v0+512
    store v17, v0
    store v16, v0+32
    store v15, v0+64
    store v14, v0+96
    store v13, v0+128
    store v12, v0+160
    store v11, v0+192
    store v10, v0+224
    store v9, v0+256
    store v8, v0+288
    store v7, v0+320
    store v6, v0+352
    store v5, v0+384
    store v4, v0+416
    store v3, v0+448
    store v2, v0+480
    store v1, v0+512
    return
}

