function %splat_insert(f64, i64, i64) {
block0(v0: f64, v1: i64, v2: i64):
    v3 = splat.f64x4 v0
    v4 = insertlane v3, v0, 2
    store v4, v2
    v5 = splat.i64x4 v1
    v6 = insertlane v5, v1, 3
    store v6, v2+32
    return
}

