function %arith(i64) {
block0(v0: i64):
    v1 = load.f64x4 v0
    v2 = fsub v1, v1
    v3 = fmul v2, v1
    v4 = fdiv v3, v1
    v5 = sqrt v4
    store v5, v0
    return
}

