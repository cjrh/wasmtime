function %fcmp_gt_select(i64) {
block0(v0: i64):
    v1 = load.f64x4 v0
    v2 = load.f64x4 v0+32
    v3 = fcmp gt v1, v2
    v4 = bitcast.f64x4 v3
    v5 = bitselect v4, v1, v2
    store v5, v0
    return
}

