;; `br_table` extends its index, and the extension can read memory.

function %br_table_load(i64) -> i64 {
block0(v0: i64):
    v1 = load.i32 v0
    br_table v1, block1, [block2, block1]
block1:
    v2 = iconst.i64 1
    return v2
block2:
    v3 = iconst.i64 2
    return v3
}

