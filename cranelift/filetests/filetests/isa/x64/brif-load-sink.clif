;; A constant that does not fit in 32 bits is put in a register.

function %load_big_imm(i64) -> i64 {
block0(v0: i64):
    v1 = load.i64 v0
    v30 = iconst.i64 0x1_0000_0000
    v2 = icmp eq v1, v30
    brif v2, block1, block2
block1:
    v3 = iconst.i64 1
    return v3
block2:
    v4 = iconst.i64 2
    return v4
}

