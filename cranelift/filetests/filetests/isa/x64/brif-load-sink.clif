;; The search loop of Plenty issue #935: `while limits[k] < r: k += 1`.

function %search_loop(i64, i64) -> i64 {
block0(v0: i64, v1: i64):
    v2 = iconst.i64 0
    jump block1(v2)
block1(v3: i64):
    v20 = iconst.i64 3
    v4 = ishl v3, v20
    v5 = iadd v0, v4
    v6 = load.i64 v5
    v7 = icmp slt v6, v1
    v21 = iconst.i64 1
    v8 = iadd v3, v21
    brif v7, block1(v8), block2
block2:
    return v3
}

