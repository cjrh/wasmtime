;; A load compared with a constant, at each width.

function %load_imm_i64(i64) -> i64 {
block0(v0: i64):
    v1 = load.i64 v0
    v30 = iconst.i64 1000
    v2 = icmp sgt v1, v30
    brif v2, block1, block2
block1:
    v3 = iconst.i64 1
    return v3
block2:
    v4 = iconst.i64 2
    return v4
}

