;; After the branch has merged the later load, an instruction of the block's
;; body can still merge the earlier one, and the loads keep their order.

function %body_merges_earlier_load(i64, i64, i64) -> i64 {
block0(v0: i64, v1: i64, v2: i64):
    v3 = load.i64 v0
    v4 = load.i64 v1
    v5 = iadd v2, v3
    v6 = icmp slt v2, v4
    brif v6, block1, block2
block1:
    return v5
block2:
    v7 = iconst.i64 2
    return v7
}

