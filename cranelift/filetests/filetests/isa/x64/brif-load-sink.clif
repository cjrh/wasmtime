;; A load with a second use stays in a register.

function %two_uses(i64, i64) -> i64 {
block0(v0: i64, v1: i64):
    v2 = load.i64 v1
    v3 = icmp slt v0, v2
    brif v3, block1, block2
block1:
    return v2
block2:
    v5 = iconst.i64 2
    return v5
}

