;   movq %rbp, %rsp
;   popq %rbp
;   retq
; block3: ; offset 0x17
;   movl $1, %eax
;   movq %rbp, %rsp
;   popq %rbp
;   retq

function %load_lhs(i64, i64) -> i64 {
block0(v0: i64, v1: i64):
    v2 = load.i64 v1
    v3 = icmp slt v2, v0
    brif v3, block1, block2
block1:
    v4 = iconst.i64 1
    return v4
block2:
    v5 = iconst.i64 2
    return v5
}

