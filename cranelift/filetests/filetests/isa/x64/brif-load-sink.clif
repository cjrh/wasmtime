;; Two loads compared with each other: only the later one can be an operand
;; of the `cmp`.

function %two_loads(i64, i64) -> i64 {
block0(v0: i64, v1: i64):
    v2 = load.i64 v0
    v3 = load.i64 v1
    v4 = icmp slt v2, v3
    brif v4, block1, block2
block1:
    v5 = iconst.i64 1
    return v5
block2:
    v6 = iconst.i64 2
    return v6
}

