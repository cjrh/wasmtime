;; A store between the load and the branch: the load stays where it is.

function %store_between(i64, i64) -> i64 {
block0(v0: i64, v1: i64):
    v2 = load.i64 v1
    store v0, v1
    v3 = icmp slt v0, v2
    brif v3, block1, block2
block1:
    v4 = iconst.i64 1
    return v4
block2:
    v5 = iconst.i64 2
    return v5
}

