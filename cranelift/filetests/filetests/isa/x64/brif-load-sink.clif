;; A narrow load on the left of a compare with a register.

function %load_lhs_i8(i64, i8) -> i64 {
block0(v0: i64, v1: i8):
    v2 = load.i8 v0
    v3 = icmp ult v2, v1
    brif v3, block1, block2
block1:
    v4 = iconst.i64 1
    return v4
block2:
    v5 = iconst.i64 2
    return v5
}

