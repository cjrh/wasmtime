;; A loaded value that the branch tests directly.

function %load_nonzero(i64) -> i64 {
block0(v0: i64):
    v1 = load.i64 v0
    brif v1, block1, block2
block1:
    v2 = iconst.i64 1
    return v2
block2:
    v3 = iconst.i64 2
    return v3
}

