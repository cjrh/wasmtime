;; The same merges apply to a compare that is not a branch's.

function %select_load_lhs(i64, i64) -> i64 {
block0(v0: i64, v1: i64):
    v2 = load.i64 v1
    v3 = icmp slt v2, v0
    v4 = select v3, v0, v1
    return v4
}

