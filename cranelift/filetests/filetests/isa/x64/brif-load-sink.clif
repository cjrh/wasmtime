;; A store before the load the branch merged still blocks an earlier load.

function %store_before_merged_load(i64, i64, i64) -> i64 {
block0(v0: i64, v1: i64, v2: i64):
    v3 = load.i64 v0
    store v2, v1
    v4 = load.i64 v1
    v5 = iadd v2, v3
    v6 = icmp slt v2, v4
    brif v6, block1, block2
block1:
    return v5
block2:
    v7 = iconst.i64 2
    return v7
}

