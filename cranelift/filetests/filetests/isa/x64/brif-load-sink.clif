;; The compare has two users, so it is lowered twice and the load cannot be
;; merged into either.

function %cmp_two_uses(i64, i64) -> i64 {
block0(v0: i64, v1: i64):
    v2 = load.i64 v1
    v3 = icmp slt v2, v0
    v4 = uextend.i64 v3
    brif v3, block1, block2
block1:
    return v4
block2:
    v5 = iconst.i64 2
    return v5
}

