test compile precise-output
target x86_64

;; A load whose only use is the compare of the block's branch is merged into
;; the `cmp`, whichever operand it is.

function %load_rhs(i64, i64) -> i64 {
block0(v0: i64, v1: i64):
    v2 = load.i64 v1
    v3 = icmp slt v0, v2
    brif v3, block1, block2
block1:
    v4 = iconst.i64 1
    return v4
block2:
    v5 = iconst.i64 2
    return v5
}

