;; The 8-byte operand of a scalar instruction needs no alignment.
function %scalar_unaligned(f64, f64) -> f64 {
    ss0 = explicit_slot 8
    fn0 = %g(f64) -> f64
block0(v0: f64, v1: f64):
    v2 = call fn0(v0)
    v3 = fadd v2, v1
    return v3
}

