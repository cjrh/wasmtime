;; `insertps` selects a source lane of a register with its immediate and
;; ignores that selection for memory: the reload stays.
function %insertps(f32x4, f32x4) -> f32x4 {
    fn0 = %g(f32x4) -> f32x4
block0(v0: f32x4, v1: f32x4):
    v2 = call fn0(v0)
    v3 = extractlane v1, 0
    v4 = insertlane v2, v3, 1
    return v4
}

