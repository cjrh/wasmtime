;; The reloaded register is the operand an instruction modifies: the reload
;; stays.
function %modified(f64, f64) -> f64 {
    fn0 = %g(f64) -> f64
block0(v0: f64, v1: f64):
    v2 = call fn0(v0)
    v3 = fsub v1, v2
    return v3
}

