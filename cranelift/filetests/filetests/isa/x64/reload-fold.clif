test compile precise-output
set regalloc_fold_reloads=true
set regalloc_forward_spills=true
set regalloc_checker=true
target x86_64 has_sse41

;; A reload whose register is read once, by an operand that also takes
;; memory, and is dead afterwards: the instruction reads the spill slot.
function %scalar(f64, f64) -> f64 {
    fn0 = %g(f64) -> f64
block0(v0: f64, v1: f64):
    v2 = call fn0(v0)
    v3 = fadd v2, v1
    return v3
}

