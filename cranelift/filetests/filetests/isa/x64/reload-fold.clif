;; The block does not write the reloaded register again and does not return,
;; so the register may be read later: the reload stays.
function %live_out(f64, f64, i32) -> f64 {
    fn0 = %g(f64) -> f64
block0(v0: f64, v1: f64, v2: i32):
    v3 = call fn0(v0)
    v4 = fadd v3, v1
    brif v2, block1, block2

block1:
    v5 = fmul v4, v1
    return v5

block2:
    return v4
}

