;; More values than registers, without a call. Reloads fold into `subsd` and
;; `addsd`; a stored register that was overwritten is not reused.
function %pressure(i64) -> f64 {
block0(v0: i64):
    v1 = load.f64 v0
    v2 = load.f64 v0+8
    v3 = load.f64 v0+16
    v4 = load.f64 v0+24
    v5 = load.f64 v0+32
    v6 = load.f64 v0+40
    v7 = load.f64 v0+48
    v8 = load.f64 v0+56
    v9 = load.f64 v0+64
    v10 = load.f64 v0+72
    v11 = load.f64 v0+80
    v12 = load.f64 v0+88
    v13 = load.f64 v0+96
    v14 = load.f64 v0+104
    v15 = load.f64 v0+112
    v16 = load.f64 v0+120
    v17 = load.f64 v0+128
    v18 = load.f64 v0+136
    v21 = fsub v1, v2
    v22 = fsub v3, v4
    v23 = fsub v5, v6
    v24 = fsub v7, v8
    v25 = fsub v9, v10
    v26 = fsub v11, v12
    v27 = fsub v13, v14
    v28 = fsub v15, v16
    v29 = fsub v17, v18
    v31 = fmul v21, v1
    v32 = fmul v22, v2
    v33 = fmul v23, v3
    v34 = fmul v24, v4
    v35 = fmul v25, v5
    v36 = fmul v26, v6
    v37 = fmul v27, v7
    v38 = fmul v28, v8
    v39 = fmul v29, v9
    v41 = fadd v31, v11
    v42 = fadd v32, v12
    v43 = fadd v33, v13
    v44 = fadd v34, v14
    v45 = fadd v35, v15
    v46 = fadd v36, v16
    v47 = fadd v37, v17
    v48 = fadd v38, v18
    v51 = fadd v41, v42
    v52 = fadd v43, v44
    v53 = fadd v45, v46
    v54 = fadd v47, v48
    v56 = fadd v51, v52
    v57 = fadd v53, v54
    v58 = fadd v56, v57
    v59 = fadd v58, v39
    v60 = fadd v59, v21
    v61 = fadd v60, v22
    v62 = fadd v61, v23
    v63 = fadd v62, v24
    return v63
}

