;   movq %rbp, %rsp
;   popq %rbp
;   retq

;; A 16-byte operand of a legacy SSE instruction must be aligned. This spill
;; slot is.
function %vector(f64x2, f64x2) -> f64x2 {
    fn0 = %g(f64x2) -> f64x2
block0(v0: f64x2, v1: f64x2):
    v2 = call fn0(v0)
    v3 = fadd v2, v1
    return v3
}

