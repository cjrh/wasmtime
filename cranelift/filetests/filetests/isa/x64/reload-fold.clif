;; The 8-byte stack slot puts the spill slot 8 bytes off a 16-byte boundary,
;; so the reload stays.
function %vector_unaligned(f64x2, f64x2) -> f64x2 {
    ss0 = explicit_slot 8
    fn0 = %g(f64x2) -> f64x2
block0(v0: f64x2, v1: f64x2):
    v2 = call fn0(v0)
    v3 = fadd v2, v1
    return v3
}

