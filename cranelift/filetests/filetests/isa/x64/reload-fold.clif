;; Two reads of the reloaded register: the reload stays.
function %two_reads(f64, f64) -> f64 {
    fn0 = %g(f64) -> f64
block0(v0: f64, v1: f64):
    v2 = call fn0(v0)
    v3 = fadd v2, v1
    v4 = fmul v3, v1
    return v4
}

